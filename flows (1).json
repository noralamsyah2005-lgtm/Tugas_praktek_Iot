    {
        "id": "f6646d36949a661f",
        "type": "function",
        "z": "c2adaee309a09307",
        "name": "Atur Batas Suhu",
        "func": "\nlet batas = Number(msg.payload.threshold);\n\nif (!Number.isFinite(batas) || batas <= 0) {\n    msg.statusCode = 400;\n    msg.payload = {\n        status: \"error\",\n        message: \"Batas suhu tidak valid\"\n    };\n    return msg;\n}\n\nflow.set(\"threshold\", batas);\n\nmsg.payload = {\n    status: \"success\",\n    message: \"Batas suhu berhasil diubah\",\n    threshold: batas\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
