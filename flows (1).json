    {
        "id": "cb785c9ea58d31b7",
        "type": "function",
        "z": "c2adaee309a09307",
        "name": "Proses Data Suhu",
        "func": "\n// Simulasi suhu\nvar suhu = 32;\n\n// Mengambil batas suhu\nvar batas = flow.get(\"threshold\");\n\n// Batas default\nif (batas === undefined || batas === null) {\n    batas = 30;\n}\n\n// Kondisi suhu\nvar kondisi = \"NORMAL\";\nvar notifikasi = \"Suhu masih normal\";\n\nif (suhu > batas) {\n    kondisi = \"BAHAYA\";\n    notifikasi = \"PERINGATAN: Suhu melewati batas!\";\n}\n\n// Membuat respons API\nmsg.payload = {\n    status: \"success\",\n    suhu: suhu,\n    batas: batas,\n    kondisi: kondisi,\n    notifikasi: notifikasi,\n    waktu: new Date().toISOString()\n};\n\nmsg.statusCode = 200;\n\n// Mengirim hasil\nreturn msg;\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 850,
        "y": 40,
        "wires": [
            [],
